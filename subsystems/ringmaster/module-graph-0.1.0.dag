: &SupportRefs, policy: &StatePolicy) -> Result<ArtifactReference, ConnectorError>", "rm_targets: pub fn resolve_target(principal: &AuthenticatedPrincipal, session: &mut NativeSession, recipe: &ArtifactReference, root: &BORootRef, authorization_ref: &EvidenceRef, limit: &DurationLimit) -> Result<BODomExport, ConnectorError>", "rm_extraction: pub fn extract_output(principal: &AuthenticatedPrincipal, session: &mut NativeSession, preparation: &PreparedTask, page: &BOPageRef, source: &ArtifactReference) -> Result<TaskOutput, ConnectorError>", "rm_delivery: pub fn take_owner_control(principal: &AuthenticatedPrincipal, handle: &ConnectorHandle) -> Result<Option<ConnectorRequest>, ConnectorError>", "rm_recovery: pub fn recover_target(principal: &AuthenticatedPrincipal, session: &mut NativeSession, preparation: &PreparedTask, handle: &ConnectorHandle, step: &ArtifactReference, failed_call: &BOPrimitiveRecord) -> Result<ArtifactReference, ConnectorError>"]
