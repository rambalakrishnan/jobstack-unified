NODE: rm_wire | modules/rm_wire | lang: rust | tier: 0 | deps: []
  READS: [seam-mappings/ringmaster-seam-mapping.md#3.1 Scalar and reference types, seam-mappings/ringmaster-seam-mapping.md#3.2 Missingness, seam-mappings/ringmaster-seam-mapping.md#3.5 Hashing and storage]
  EXPOSES: ["pub fn validate_record(schema_id: &str, bytes: &[u8]) -> Result<(), String>", "pub fn canonical_digest(bytes: &[u8]) -> Result<Digest, String>", "pub fn artifact_digest(bytes: &[u8]) -> Digest"]
  CONSUMES: []
  TEST_ASSERTIONS: [RM-C01, RM-C02]
  INVARIANTS: [EK-NULL, EK-HASHES, EXT-TIME-NULL]
  FORBIDDEN:
    - Accepting duplicate keys, non-finite numbers, unknown versions, undeclared closed-object fields, or normalized bare nulls.
    - Inserting defaults, normalizing Unicode, reordering arrays, or redacting bytes during canonicalization.
    - Treating structural validation or a valid digest as authentication or semantic conformance.
    - Replacing the registered lowercase conformance filters with unrelated test-name filters.
  VERIFICATION: cargo test -p rm_wire -- rm-c01 rm-c02

NODE: rm_time | modules/rm_time | lang: rust | tier: 1 | deps: [rm_wire]
  READS: [seam-mappings/ringmaster-seam-mapping.md#3.3 Clocks and TimePoint, seam-mappings/ringmaster-seam-mapping.md#3.4 Measurement]
