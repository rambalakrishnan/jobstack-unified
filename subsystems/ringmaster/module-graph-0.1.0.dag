  CONSUMES: ["rm_wire: pub fn validate_record(schema_id: &str, bytes: &[u8]) -> Result<(), String>", "rm_wire: pub fn canonical_digest(bytes: &[u8]) -> Result<Digest, String>", "rm_wire: pub fn artifact_digest(bytes: &[u8]) -> Digest", "rm_time: pub fn validate_measurement(measurement: &Measurement, clocks: &[ClockDescriptor]) -> Result<(), String>", "rm_authority: pub struct AuthenticatedPrincipal { principal_id: String, registration_digest: Digest }", "rm_authority: pub fn authorize_owner(principal: &AuthenticatedPrincipal, owner_domain: &str, event_kind: &str) -> Result<ProducerDescriptor, ConnectorError>"]
  TEST_ASSERTIONS: [RM-C49, RM-C58]
  INVARIANTS: [EK-JOURNAL, EK-ATOMICITY, EK-HASHES, EK-PROVENANCE, EK-OBSERVATION, EK-ARTIFACTS, LIFE-EVIDENCE, EXT-EVIDENCE, EXT-ARTIFACTS, OWD-LOCAL-COMMIT, OWD-PUBLISH, OWD-RETENTION]
  FORBIDDEN:
    - Accepting caller-authored JournalEnvelope authority fields instead of authenticated EventSubmission content.
    - Acknowledging an owner effect before its input, deduplication record, effects, journal events, and replayable response commit durably.
    - Using append_event to split an authoritative effect from its required owner-local atomic commit.
    - Acquiring another owner's transaction or waiting for peer publication on the owner commit path.
    - Registering absent artifact bytes, citing a future registration, or replacing bytes under an existing digest.
    - Repairing a journal gap by repeating an external action.
    - Collecting artifacts reachable from retained prefixes, publications, replay bundles, or archives.
  VERIFICATION: cargo test -p rm_evidence -- rm-c49 rm-c58

